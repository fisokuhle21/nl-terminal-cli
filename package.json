{
  "name": "nl-terminal-cli",
  "version": "0.0.1",
  "description": "Natural Language Terminal CLI - Execute terminal commands using natural language",
  "main": "dist/src/index.js",
  "type": "module",
  "bin": {
    "nl-terminal": "dist/src/cli.js"
  },
  "files": [
    "dist",
    "install.sh",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "build": "npm run build:node",
    "build:node": "tsc",
    "build:bun": "bun build ./src/cli.ts --outfile ./dist/bun-cli.js --target bun",
    "build:all": "npm run build:node && npm run build:bun",
    "dev": "tsc --watch",
    "dev:bun": "bun --watch ./src/cli.ts run",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "start": "node dist/src/cli.js",
    "start:node": "node dist/src/cli.js",
    "start:bun": "bun run dist/bun-cli.js",
    "seed": "node --loader ts-node/esm scripts/seed.ts",
    "seed:bun": "bun run scripts/seed.ts",
    "test": "NL_TERMINAL_CLI_TEST=1 node --test dist/tests/*.test.js",
    "test:bun": "NL_TERMINAL_CLI_TEST=1 bun test",
    "test:all": "npm run test && npm run test:bun",
    "test:benchmark": "NL_TERMINAL_CLI_TEST=1 node --test dist/tests/benchmark.test.js",
    "perf": "./scripts/perf-test.sh",
    "perf:quick": "./scripts/perf-test.sh --help"
  },
  "keywords": [
    "cli",
    "terminal",
    "natural-language",
    "commands"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "glob": "^10.3.10",
    "inquirer": "^9.2.12",
    "inquirer-autocomplete-prompt": "^3.0.1",
    "ora": "^9.0.0",
    "shell-quote": "^1.8.3",
    "string-similarity": "^4.0.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.10.0",
    "@types/shell-quote": "^1.7.5",
    "@types/string-similarity": "^4.0.2",
    "bun-types": "^1.3.8",
    "typescript": "^5.3.3"
  }
}
